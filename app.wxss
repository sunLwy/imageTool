page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #333;
}

.container {
  padding: 32rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.btn-primary {
  background: linear-gradient(135deg, #4f7cff, #6a5cff);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background: #c5c8d4;
  color: #fff;
}

.btn-outline {
  background: #fff;
  color: #4f7cff;
  border: 2rpx solid #4f7cff;
  border-radius: 48rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  padding: 0 32rpx;
}

.btn-outline::after {
  border: none;
}
