<view class="container">
  <!-- 选图 -->
  <view class="upload-area" bindtap="chooseImage" wx:if="{{!hasImage && !batchMode}}">
    <image class="upload-icon" src="/images/icon-add.png" mode="aspectFit" />
    <view class="upload-text">点击选择照片（最多 9 张）</view>
    <view class="upload-tip">自动读取每张拍摄时间，批量添加日期戳</view>
  </view>

  <!-- 功能说明（未选图时显示） -->
  <view class="feature-card" wx:if="{{!hasImage && !batchMode}}">
    <view class="feature-title">时间水印功能说明</view>
    <view class="feature-item">✓ 自动读取照片 EXIF 拍摄日期与时间</view>
    <view class="feature-item">✓ 支持批量，一次最多 9 张统一处理</view>
    <view class="feature-item">✓ 经典冲印 / 简约两种时间戳样式</view>
    <view class="feature-item">✓ 识别不到时自动用今天日期，本地处理不上传</view>
  </view>

  <!-- ============ 单张编辑区 ============ -->
  <block wx:if="{{hasImage && !batchMode}}">
    <view class="preview-card">
      <image src="{{previewPath}}" mode="widthFix" class="preview-image" show-menu-by-longpress="{{false}}" />
    </view>

    <view class="opt-card">
      <view class="opt-row">
        <text class="opt-label">拍摄时间</text>
        <view class="exif-tag {{exifDetected ? 'ok' : 'manual'}}">
          {{exifDetected ? '已自动识别' : '手动设置'}}
        </view>
      </view>
      <view class="date-row">
        <picker mode="date" value="{{stampDate}}" bindchange="onDateChange" class="date-picker">
          <view class="date-box">{{stampDate}}</view>
        </picker>
        <picker mode="time" value="{{stampTime}}" bindchange="onTimeChange" class="date-picker" wx:if="{{showTime}}">
          <view class="date-box">{{stampTime}}</view>
        </picker>
      </view>
    </view>

    <view class="opt-card">
      <view class="opt-label">样式</view>
      <view class="seg-row">
        <view class="seg {{stampStyle === 'classic' ? 'active' : ''}}" bindtap="setStyle" data-value="classic">经典冲印</view>
        <view class="seg {{stampStyle === 'minimal' ? 'active' : ''}}" bindtap="setStyle" data-value="minimal">简约</view>
      </view>
    </view>

    <view class="opt-card">
      <view class="opt-label">内容</view>
      <view class="seg-row">
        <view class="seg {{!showTime ? 'active' : ''}}" bindtap="setFormat" data-value="date">仅日期</view>
        <view class="seg {{showTime ? 'active' : ''}}" bindtap="setFormat" data-value="datetime">日期+时间</view>
      </view>
    </view>

    <view class="opt-card">
      <view class="opt-label">字号</view>
      <view class="seg-row">
        <view class="seg {{fontSizeLevel === 's' ? 'active' : ''}}" bindtap="setFontSize" data-level="s">小</view>
        <view class="seg {{fontSizeLevel === 'm' ? 'active' : ''}}" bindtap="setFontSize" data-level="m">中</view>
        <view class="seg {{fontSizeLevel === 'l' ? 'active' : ''}}" bindtap="setFontSize" data-level="l">大</view>
      </view>
    </view>

    <view class="opt-card">
      <view class="opt-label">位置</view>
      <view class="pos-grid">
        <view class="pos {{position === 'lt' ? 'active' : ''}}" bindtap="setPosition" data-value="lt">↖</view>
        <view class="pos {{position === 'rt' ? 'active' : ''}}" bindtap="setPosition" data-value="rt">↗</view>
        <view class="pos {{position === 'lb' ? 'active' : ''}}" bindtap="setPosition" data-value="lb">↙</view>
        <view class="pos {{position === 'rb' ? 'active' : ''}}" bindtap="setPosition" data-value="rb">↘</view>
      </view>
    </view>

    <button class="btn-primary save-btn" bindtap="saveImage" loading="{{saving}}" disabled="{{saving || rendering}}">
      {{saving ? '保存中...' : '保存到相册'}}
    </button>
    <view class="reselect" bindtap="chooseImage">重新选择照片</view>
    <view class="cancel-link" bindtap="cancelEdit">取消</view>
  </block>

  <!-- ============ 批量模式 ============ -->
  <block wx:if="{{batchMode}}">
    <view class="batch-head">
      已选 {{jobs.length}} 张，每张自动加自己的拍摄日期
    </view>

    <view class="batch-grid">
      <view class="batch-cell" wx:for="{{jobs}}" wx:key="index">
        <view class="batch-thumb-wrap">
          <image src="{{item.src}}" mode="aspectFill" class="batch-thumb" />
          <view class="batch-status batch-status-{{item.status}}" wx:if="{{item.status === 'done' || item.status === 'error'}}">
            {{item.status === 'done' ? '✓' : '✕'}}
          </view>
        </view>
        <view class="batch-date {{item.detected ? '' : 'fallback'}}">{{item.dateText}}</view>
      </view>
    </view>

    <!-- 未识别时间的照片：手动时间只作用于这些 -->
    <view class="opt-card" wx:if="{{showFallbackPicker}}">
      <view class="opt-row">
        <text class="opt-label">未识别时间（{{fbCount}} 张）</text>
        <view class="exif-tag manual">手动设置</view>
      </view>
      <view class="date-row">
        <picker mode="date" value="{{fbDate}}" bindchange="onFbDateChange" class="date-picker">
          <view class="date-box">{{fbDate}}</view>
        </picker>
        <picker mode="time" value="{{fbTime}}" bindchange="onFbTimeChange" class="date-picker" wx:if="{{showTime}}">
          <view class="date-box">{{fbTime}}</view>
        </picker>
      </view>
      <view class="fb-tip">此时间只作用于上面这些未识别到拍摄时间的照片</view>
    </view>

    <!-- 全局选项（批量统一作用全部） -->
    <view class="opt-card">
      <view class="opt-label">样式</view>
      <view class="seg-row">
        <view class="seg {{stampStyle === 'classic' ? 'active' : ''}}" bindtap="setStyle" data-value="classic">经典冲印</view>
        <view class="seg {{stampStyle === 'minimal' ? 'active' : ''}}" bindtap="setStyle" data-value="minimal">简约</view>
      </view>
    </view>

    <view class="opt-card">
      <view class="opt-label">内容</view>
      <view class="seg-row">
        <view class="seg {{!showTime ? 'active' : ''}}" bindtap="setFormat" data-value="date">仅日期</view>
        <view class="seg {{showTime ? 'active' : ''}}" bindtap="setFormat" data-value="datetime">日期+时间</view>
      </view>
    </view>

    <view class="opt-card">
      <view class="opt-label">字号</view>
      <view class="seg-row">
        <view class="seg {{fontSizeLevel === 's' ? 'active' : ''}}" bindtap="setFontSize" data-level="s">小</view>
        <view class="seg {{fontSizeLevel === 'm' ? 'active' : ''}}" bindtap="setFontSize" data-level="m">中</view>
        <view class="seg {{fontSizeLevel === 'l' ? 'active' : ''}}" bindtap="setFontSize" data-level="l">大</view>
      </view>
    </view>

    <view class="opt-card">
      <view class="opt-label">位置</view>
      <view class="pos-grid">
        <view class="pos {{position === 'lt' ? 'active' : ''}}" bindtap="setPosition" data-value="lt">↖</view>
        <view class="pos {{position === 'rt' ? 'active' : ''}}" bindtap="setPosition" data-value="rt">↗</view>
        <view class="pos {{position === 'lb' ? 'active' : ''}}" bindtap="setPosition" data-value="lb">↙</view>
        <view class="pos {{position === 'rb' ? 'active' : ''}}" bindtap="setPosition" data-value="rb">↘</view>
      </view>
    </view>

    <button wx:if="{{!batchDone}}" class="btn-primary save-btn" bindtap="startBatch" loading="{{processing}}" disabled="{{processing}}">
      {{processing ? '处理中 ' + doneCount + '/' + jobs.length : '开始处理（' + jobs.length + ' 张）'}}
    </button>
    <button wx:if="{{batchDone && !batchSaved}}" class="btn-primary save-btn" bindtap="saveBatch" loading="{{saving}}" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存全部到相册'}}
    </button>
    <view wx:if="{{batchSaved}}" class="batch-done-tip">已保存到相册，可重新选择</view>

    <view class="reselect" bindtap="chooseImage">重新选择照片</view>
    <view class="cancel-link" bindtap="cancelEdit">取消</view>
  </block>

  <view class="privacy-tip" wx:if="{{!hasImage && !batchMode}}">
    所有图片均在手机本地处理，不会上传到任何服务器
  </view>
</view>
