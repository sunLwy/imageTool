/* ===== 选图区域 ===== */
.upload-area {
  background: #fff;
  border: 2rpx dashed #c5c8d4;
  border-radius: 24rpx;
  padding: 100rpx 0;
  text-align: center;
}
.upload-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 8rpx;
  display: block;
}
.upload-text {
  font-size: 32rpx;
  color: #333;
  margin-top: 24rpx;
}
.upload-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

/* ===== 功能说明 ===== */
.feature-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx 0;
}
.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}
.feature-item {
  font-size: 26rpx;
  color: #666;
  line-height: 2;
}

/* ===== 预览 ===== */
.preview-card {
  background: #000;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.preview-image {
  width: 100%;
  display: block;
}

/* ===== 选项卡片 ===== */
.opt-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.opt-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}
.opt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.opt-row .opt-label {
  margin-bottom: 0;
}

/* 识别状态标签 */
.exif-tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}
.exif-tag.ok {
  color: #2ba471;
  background: #e7f7ef;
}
.exif-tag.manual {
  color: #b8860b;
  background: #fdf5e0;
}

/* 日期时间选择 */
.date-row {
  display: flex;
  margin-top: 20rpx;
}
.date-picker {
  flex: 1;
  margin-right: 20rpx;
}
.date-picker:last-child {
  margin-right: 0;
}
.date-box {
  background: #f5f5f5;
  border-radius: 16rpx;
  text-align: center;
  padding: 22rpx 0;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

/* 分段控件（不用 flex gap，兼容真机） */
.seg-row {
  display: flex;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 6rpx;
}
.seg {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: #666;
  padding: 18rpx 0;
  border-radius: 12rpx;
}
.seg.active {
  background: #fff;
  color: #4f7cff;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

/* 四角位置网格 */
.pos-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 8rpx;
}
.pos {
  width: 23%;
  height: 120rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #999;
  margin-bottom: 12rpx;
}
.pos.active {
  background: #eef2ff;
  color: #4f7cff;
  box-shadow: inset 0 0 0 2rpx #4f7cff;
}

/* ===== 按钮 ===== */
.save-btn {
  margin-top: 8rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.reselect {
  text-align: center;
  color: #4f7cff;
  font-size: 28rpx;
  padding: 28rpx 0 8rpx;
}
.cancel-link {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 16rpx 0 0;
}

.privacy-tip {
  font-size: 22rpx;
  color: #aaa;
  text-align: center;
  padding: 24rpx 0 60rpx;
  line-height: 1.6;
}

/* ===== 批量模式 ===== */
.batch-head {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: #666;
}
.batch-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.batch-cell {
  width: 32%;
  margin-right: 2%;
  margin-bottom: 20rpx;
}
.batch-cell:nth-child(3n) {
  margin-right: 0;
}
.batch-thumb-wrap {
  position: relative;
  width: 100%;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f0f0f0;
}
.batch-thumb {
  width: 100%;
  height: 100%;
  display: block;
}
.batch-status {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  font-size: 20rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.batch-status-done { background: #2ba471; }
.batch-status-error { background: #e5484d; }
.batch-date {
  font-size: 20rpx;
  color: #333;
  text-align: center;
  margin-top: 8rpx;
  line-height: 1.3;
}
.batch-date.fallback {
  color: #b8860b;
}
.batch-done-tip {
  text-align: center;
  color: #2ba471;
  font-size: 28rpx;
  padding: 24rpx 0 8rpx;
  font-weight: 600;
}
.fb-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
  line-height: 1.5;
}
