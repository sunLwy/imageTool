<view class="container">
  <!-- 选图区域 -->
  <view class="upload-area" bindtap="chooseImage" wx:if="{{!originalPath}}">
    <image class="upload-icon" src="/images/icon-add.png" mode="aspectFit" />
    <view class="upload-text">点击选择图片</view>
    <view class="upload-tip">支持 JPG / PNG / HEIC</view>
  </view>

  <!-- 已选图：原图信息（压缩完成后隐藏，只显示结果） -->
  <view class="image-card" wx:if="{{originalPath && !compressedPath}}">
    <image src="{{originalPath}}" mode="aspectFit" class="preview-image" />
    <view class="info-row">
      <text class="info-label">原图</text>
      <text class="info-value">{{originalSize}} · {{originalWidth}}×{{originalHeight}}</text>
    </view>

    <!-- 压缩模式切换 -->
    <view class="mode-tabs">
      <view class="mode-tab {{compressMode === 'quality' ? 'active' : ''}}" bindtap="switchMode" data-mode="quality">按质量</view>
      <view class="mode-tab {{compressMode === 'targetSize' ? 'active' : ''}}" bindtap="switchMode" data-mode="targetSize">按大小</view>
    </view>

    <!-- 按质量模式：滑条 -->
    <view class="slider-row" wx:if="{{compressMode === 'quality'}}">
      <view class="slider-header">
        <text class="slider-label">压缩质量</text>
        <text class="slider-value">{{quality}}%</text>
      </view>
      <slider min="10" max="100" value="{{quality}}" activeColor="#4f7cff" block-size="20" bindchange="onQualityChange" />
    </view>
    <view class="slider-tip" wx:if="{{compressMode === 'quality'}}">质量越高越清晰，文件越大</view>

    <!-- 按大小模式：预设大小 -->
    <view class="size-preset" wx:if="{{compressMode === 'targetSize'}}">
      <view class="size-option {{targetSize === 200 ? 'active' : ''}}" bindtap="selectSize" data-size="200">200KB</view>
      <view class="size-option {{targetSize === 500 ? 'active' : ''}}" bindtap="selectSize" data-size="500">500KB</view>
      <view class="size-option {{targetSize === 1024 ? 'active' : ''}}" bindtap="selectSize" data-size="1024">1MB</view>
      <view class="size-option {{targetSize === 2048 ? 'active' : ''}}" bindtap="selectSize" data-size="2048">2MB</view>
    </view>
    <view class="custom-size-row" wx:if="{{compressMode === 'targetSize'}}">
      <input class="custom-size-input" type="number" placeholder="自定义大小(KB)" value="{{customSize}}" bindinput="onCustomSizeInput" />
      <text class="custom-size-unit">KB</text>
    </view>
    <view class="slider-tip" wx:if="{{compressMode === 'targetSize'}}">自动调整质量，压缩到目标大小以内</view>

    <!-- 压缩按钮 -->
    <button class="btn-primary compress-btn" bindtap="compressImage" loading="{{compressing}}" disabled="{{compressing}}">
      {{compressing ? '压缩中...' : '立即压缩'}}
    </button>

    <!-- 重新选图 -->
    <view class="reselect" bindtap="chooseImage">重新选择</view>
  </view>

  <!-- 压缩结果 -->
  <view class="image-card result-card" wx:if="{{compressedPath}}">
    <view class="result-badge">压缩完成</view>
    <image src="{{compressedPath}}" mode="aspectFit" class="preview-image" />
    <view class="info-row">
      <text class="info-label">压缩后</text>
      <text class="info-value">{{compressedSize}} · {{compressedWidth}}×{{compressedHeight}}</text>
    </view>
    <view class="saving-info" wx:if="{{savingPercent > 0}}">
      节省了 {{savingPercent}}% 空间
    </view>

    <button class="btn-primary save-btn" bindtap="saveImage" loading="{{saving}}" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存到相册'}}
    </button>

    <button class="btn-outline recompress-btn" bindtap="resetResult">调整参数重新压缩</button>
  </view>

  <!-- 功能介绍（未选图时显示） -->
  <view class="feature-card" wx:if="{{!originalPath}}">
    <view class="feature-title">压缩功能说明</view>
    <view class="feature-item">✓ 一键压缩图片，减少文件体积</view>
    <view class="feature-item">✓ 按质量 / 按指定大小两种模式</view>
    <view class="feature-item">✓ HEIC/PNG 自动转 JPG</view>
    <view class="feature-item">✓ 本地完成处理，压缩后可保存相册</view>
  </view>

  <!-- 隐私说明 -->
  <view class="privacy-tip">
    图片在手机本地处理，隐私安全有保障
  </view>
</view>
