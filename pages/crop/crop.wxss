/* ===== 选图页 ===== */
.upload-area {
  background: #fff;
  border: 2rpx dashed #c5c8d4;
  border-radius: 24rpx;
  padding: 140rpx 0;
  text-align: center;
}
.upload-icon {
  font-size: 80rpx;
  color: #c5c8d4;
  line-height: 1;
}
.upload-text {
  font-size: 32rpx;
  color: #333;
  margin-top: 24rpx;
  font-weight: 500;
}
.upload-tip {
  font-size: 24rpx;
  color: #aaa;
  margin-top: 12rpx;
}

/* ===== 裁剪舞台（黑色圆角卡片，非全屏） ===== */
.crop-stage {
  position: relative;
  width: 100%;
  background: #000;
  border-radius: 24rpx;
  overflow: hidden;
  margin: 8rpx auto 0;
  touch-action: none;
}
/* 可拖动缩放的图片层（自定义手势，绝对定位） */
.img-wrap {
  position: absolute;
  transform-origin: center center;
  will-change: transform;
  z-index: 10;
}
.img-wrap.is-anim {
  transition: transform 0.22s ease-out;
}
.crop-image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 裁剪框：遮罩 + 边框 */
.crop-frame {
  position: absolute;
  box-shadow: 0 0 0 9999rpx rgba(0,0,0,0.55);
  box-sizing: border-box;
  pointer-events: none;
  z-index: 20;
}

/* 四角 L 形角标 */
.corner {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border-color: #fff;
  border-style: solid;
  border-width: 0;
}
.corner.tl { top: -2rpx; left: -2rpx; border-top-width: 4rpx; border-left-width: 4rpx; border-top-left-radius: 8rpx; }
.corner.tr { top: -2rpx; right: -2rpx; border-top-width: 4rpx; border-right-width: 4rpx; border-top-right-radius: 8rpx; }
.corner.bl { bottom: -2rpx; left: -2rpx; border-bottom-width: 4rpx; border-left-width: 4rpx; border-bottom-left-radius: 8rpx; }
.corner.br { bottom: -2rpx; right: -2rpx; border-bottom-width: 4rpx; border-right-width: 4rpx; border-bottom-right-radius: 8rpx; }

/* 三分网格线 */
.grid-v {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 1rpx;
  background: rgba(255,255,255,0.35);
}
.grid-v.gv1 { left: 33.333%; }
.grid-v.gv2 { left: 66.666%; }
.grid-h {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: rgba(255,255,255,0.35);
}
.grid-h.gh1 { top: 33.333%; }
.grid-h.gh2 { top: 66.666%; }

/* ===== 比例条（白色卡片） ===== */
.ratio-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-top: 24rpx;
}
.ratio-scroll {
  white-space: nowrap;
}
.ratio-item {
  display: inline-block;
  font-size: 26rpx;
  color: #666;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 36rpx;
  border: 2rpx solid #e5e5e5;
}
.ratio-item.active {
  color: #4f7cff;
  background: #eef2ff;
  border-color: #4f7cff;
  font-weight: 600;
}

/* ===== 工具行（白色卡片） ===== */
.tools-row {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  margin-top: 24rpx;
  padding: 24rpx 0;
}
.tool-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tool-ico {
  font-size: 44rpx;
  color: #333;
  line-height: 1;
}
.tool-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 12rpx;
}

/* ===== 完成按钮 ===== */
.done-btn {
  margin-top: 32rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cancel-link {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 20rpx 0 40rpx;
}

/* ===== 结果卡片 ===== */
.result-card {
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 24rpx;
}
.result-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: #4f7cff;
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}
.preview-image {
  width: 100%;
  background: #f5f5f5;
  border-radius: 16rpx;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.info-label { font-size: 28rpx; color: #666; }
.info-value { font-size: 28rpx; color: #333; font-weight: 500; }
.save-btn {
  margin-top: 32rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.recompress-btn {
  margin-top: 20rpx;
  height: 80rpx;
  line-height: 80rpx;
}

/* 功能说明 */
.feature-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx 0;
}
.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}
.feature-item {
  font-size: 26rpx;
  color: #666;
  line-height: 2;
}

.privacy-tip {
  font-size: 22rpx;
  color: #aaa;
  text-align: center;
  padding: 24rpx 0 60rpx;
  line-height: 1.6;
}
