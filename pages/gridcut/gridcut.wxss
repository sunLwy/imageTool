/* ===== 选图区域 ===== */
.upload-area {
  background: #fff;
  border: 2rpx dashed #c5c8d4;
  border-radius: 24rpx;
  padding: 100rpx 0;
  text-align: center;
}
.upload-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 8rpx;
  display: block;
}
.upload-text {
  font-size: 32rpx;
  color: #333;
  margin-top: 24rpx;
}
.upload-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

/* ===== 功能说明 ===== */
.feature-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx 0;
}
.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}
.feature-item {
  font-size: 26rpx;
  color: #666;
  line-height: 2;
}

/* ===== 九宫格结果 ===== */
.cut-grid {
  background: #fff;
  border-radius: 24rpx;
  padding: 16rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.cut-cell {
  width: 32%;
  height: 210rpx;
  margin-bottom: 12rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
}
.cut-tip {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding: 20rpx 0 8rpx;
  line-height: 1.6;
}

/* ===== 按钮 ===== */
.save-btn {
  margin-top: 16rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.reselect {
  text-align: center;
  color: #4f7cff;
  font-size: 28rpx;
  padding: 28rpx 0 8rpx;
}
.cancel-link {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 16rpx 0 0;
}

.privacy-tip {
  font-size: 22rpx;
  color: #aaa;
  text-align: center;
  padding: 24rpx 0 60rpx;
  line-height: 1.6;
}
