<view class="container">
  <!-- 选图 -->
  <view class="upload-area" bindtap="chooseImage" wx:if="{{phase === 'pick'}}">
    <image class="upload-icon" src="/images/icon-add.png" mode="aspectFit" />
    <view class="upload-text">点击选择照片</view>
    <view class="upload-tip">自动取中间正方形，可拖动微调保留区域</view>
  </view>

  <view class="feature-card" wx:if="{{phase === 'pick'}}">
    <view class="feature-title">九宫格切图说明</view>
    <view class="feature-item">✓ 自动取画面中间正方形区域</view>
    <view class="feature-item">✓ 竖图上下拖、横图左右拖微调保留位置</view>
    <view class="feature-item">✓ 网格线即切分位置，保存 9 张发朋友圈</view>
    <view class="feature-item">✓ 本地完成处理，不存储到我们服务器</view>
  </view>

  <!-- 切图：可拖动大图 + 九宫格线，所见即所得 -->
  <block wx:if="{{phase === 'editing'}}">
    <view class="crop-wrap">
      <movable-area class="crop-area" style="width:{{areaSize}}px;height:{{areaSize}}px">
        <movable-view class="crop-view" direction="{{cropDir === 'v' ? 'vertical' : cropDir === 'h' ? 'horizontal' : 'none'}}"
          style="width:{{viewW}}px;height:{{viewH}}px" x="{{initX}}" y="{{initY}}" bindchange="onDragChange" inertia="false">
          <image src="{{cropPath}}" mode="scaleToFill" class="crop-img" />
        </movable-view>
      </movable-area>
      <!-- 九宫格线 -->
      <view class="grid-line v" style="left:33.333%"></view>
      <view class="grid-line v" style="left:66.666%"></view>
      <view class="grid-line h" style="top:33.333%"></view>
      <view class="grid-line h" style="top:66.666%"></view>
    </view>
    <view class="cut-tip">{{cropDir === 'v' ? '上下拖动，调整要保留的画面' : cropDir === 'h' ? '左右拖动，调整要保留的画面' : '网格框住的就是要切出的 9 张'}}</view>

    <button class="btn-primary save-btn" bindtap="cutAndSave" loading="{{saving}}" disabled="{{saving}}">
      {{saving ? '处理中...' : '保存 9 张到相册'}}
    </button>
    <view class="cancel-link" bindtap="reset">重新选图</view>
  </block>

  <view class="privacy-tip" wx:if="{{phase === 'pick'}}">
    图片在手机本地完成处理，不存储到我们的服务器；仅生成缩略图提交微信官方安全接口做内容检测
  </view>
</view>
