<view class="container">
  <!-- 工具宫格 -->
  <view class="grid">
    <view class="grid-cell" wx:for="{{tools}}" wx:key="key"
      bindtap="openTool" data-url="{{item.url}}">
      <image class="cell-icon" src="{{item.icon}}" mode="aspectFit" />
      <view class="cell-name">{{item.name}}</view>
      <view class="cell-desc">{{item.desc}}</view>
    </view>
  </view>

  <!-- 说明 -->
  <view class="home-note">
    <view class="note-item">✓ 所有图片均在手机本地处理，不上传服务器</view>
    <view class="note-item">✓ 支持 JPG / PNG / HEIC，免费使用</view>
  </view>

  <view class="about-link" bindtap="goAbout">关于我们</view>

  <!-- 隐私协议弹窗 -->
  <view class="modal-mask" wx:if="{{showPrivacyModal}}" bindtap="onPrivacyMaskTap">
    <view class="modal-content">
      <view class="modal-title">隐私保护说明</view>
      <view class="modal-body">
        <view>欢迎使用小胡轻图。我们非常重视您的隐私：</view>
        <view style="height: 20rpx;"></view>
        <view>1. 您选择的图片仅在您的手机本地进行压缩、裁剪、加水印、切图等处理，不会上传到任何服务器。</view>
        <view style="height: 16rpx;"></view>
        <view>2. 我们需要访问您的相册来选择图片，以及保存处理后的图片到您的相册。</view>
        <view style="height: 16rpx;"></view>
        <view>3. 我们不会收集、存储或分享您的任何个人信息或图片内容。</view>
      </view>
      <view class="modal-btns">
        <button class="modal-btn-cancel" bindtap="rejectPrivacy">不同意</button>
        <button class="modal-btn-confirm" bindtap="agreePrivacy">同意并继续</button>
      </view>
    </view>
  </view>
</view>
