/* 工具宫格（兼容真机：不用 flex gap，用 space-between） */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.grid-cell {
  width: 48%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 0 40rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}
.grid-cell:active {
  background: #f5f7ff;
}
.cell-icon {
  width: 84rpx;
  height: 84rpx;
  margin: 0 auto;
  display: block;
}
.cell-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-top: 20rpx;
}
.cell-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 说明卡片 */
.home-note {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-top: 32rpx;
}
.note-item {
  font-size: 26rpx;
  color: #666;
  line-height: 2.2;
}

/* 关于入口 */
.about-link {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 40rpx 0 60rpx;
}

/* 隐私弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-content {
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}
.modal-body {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  max-height: 500rpx;
  overflow-y: auto;
}
.modal-btns {
  display: flex;
  margin-top: 32rpx;
}
.modal-btn-cancel {
  flex: 1;
  margin-right: 20rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 48rpx;
  font-size: 28rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-btn-cancel::after { border: none; }
.modal-btn-confirm {
  flex: 1;
  background: linear-gradient(135deg, #4f7cff, #6a5cff);
  color: #fff;
  border-radius: 48rpx;
  font-size: 28rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-btn-confirm::after { border: none; }
